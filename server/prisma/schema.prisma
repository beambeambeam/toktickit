generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestedPriority {
  Low
  Medium
  High
  Urgent
}

enum CurrentStatus {
  New
  Open
  InProgress          @map("In Progress")
  WaitingForRequester @map("Waiting for Requester")
  Resolved
  Closed
  Reopened
  Cancelled
}

enum UserRole {
  Requester
  ITStaff
  Administrator
}

enum ActionStatus {
  Planned
  InProgress @map("In Progress")
  Completed
  Cancelled
}

enum ActionEventType {
  ActionCreated
  ActionEdited
  ActionStarted
  ActionCompleted
  ActionCancelled
}

model Category {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  seedKey       String?  @unique
  tickets       Ticket[]

  @@index([isActive, displayOrder])
}

model RelatedSystem {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  seedKey       String?  @unique
  tickets       Ticket[]

  @@index([isActive, displayOrder])
}

model User {
  id                  Int          @id @default(autoincrement())
  displayName         String
  email               String       @unique
  role                UserRole     @default(Requester)
  passwordHash        String?
  mustChangePassword  Boolean      @default(true)
  isActive            Boolean      @default(true)
  seedKey             String?      @unique
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  tickets             Ticket[]
  ownedTickets        Ticket[]     @relation("TicketOwner")
  resolutionIndications Ticket[]   @relation("TicketResolutionIndication")
  removedAttachments  Attachment[] @relation("RemovedAttachmentUser")
  internalNotes       InternalNote[] @relation("InternalNoteAuthor")
  publicComments      PublicComment[] @relation("PublicCommentAuthor")
  sessions            Session[]
  createdActions      ActionTaken[]   @relation("ActionCreatedBy")
  assignedActions     ActionTaken[]   @relation("ActionAssignee")
  performedActions    ActionTaken[]   @relation("ActionPerformedBy")
  completedActions    ActionTaken[]   @relation("ActionCompletedBy")
  cancelledActions    ActionTaken[]   @relation("ActionCancelledBy")
  actionEvents        ActionEvent[]   @relation("ActionEventActor")

  @@index([isActive, displayName])
}

model Ticket {
  id                 Int              @id @default(autoincrement())
  ticketNumber       String           @unique
  ticketDate         DateTime         @default(now())
  requesterId        Int
  categoryId         Int
  relatedSystemId    Int
  summary            String
  description        String
  requestedPriority  RequestedPriority
  itPriority         RequestedPriority
  currentStatus      CurrentStatus    @default(New)
  ownerId            Int?
  version            Int              @default(1)
  resolutionIndicatedAt       DateTime?
  resolutionIndicatedByUserId Int?
  statusChangedAt    DateTime         @default(now())
  resolvedAt         DateTime?
  reopenedAt         DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  seedKey            String?          @unique
  requester          User             @relation(fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner              User?            @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  resolutionIndicatedBy User?        @relation("TicketResolutionIndication", fields: [resolutionIndicatedByUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  category           Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  relatedSystem      RelatedSystem    @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attachments        Attachment[]
  internalNotes      InternalNote[]
  publicComments     PublicComment[]
  actionsTaken       ActionTaken[]

  @@index([requesterId, updatedAt])
  @@index([requesterId, currentStatus])
  @@index([requesterId, requestedPriority])
  @@index([requesterId, categoryId])
  @@index([requesterId, relatedSystemId])
  @@index([updatedAt, id])
  @@index([ownerId])
  @@index([currentStatus])
  @@index([itPriority])
  @@index([categoryId, relatedSystemId])
}

model ActionTaken {
  id                  Int          @id @default(autoincrement())
  ticketId            Int
  createdByUserId     Int
  assigneeId          Int
  performedByUserId   Int?
  completedByUserId   Int?
  cancelledByUserId   Int?
  description         String
  result              String?
  followUpRequired    Boolean      @default(false)
  followUpNote        String?
  attachmentNotes     String?
  status              ActionStatus @default(Planned)
  version             Int          @default(1)
  requestId           String       @db.Uuid
  payloadHash         String       @db.Char(64)
  seedKey             String?      @unique
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
  startedAt           DateTime? @db.Timestamptz(3)
  completedAt         DateTime? @db.Timestamptz(3)
  cancelledAt         DateTime? @db.Timestamptz(3)
  ticket              Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy           User         @relation("ActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignee            User         @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  performedBy         User?        @relation("ActionPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  completedBy         User?        @relation("ActionCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledBy         User?        @relation("ActionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  events              ActionEvent[]

  @@unique([ticketId, createdByUserId, requestId])
  @@index([ticketId, createdAt, id])
  @@index([ticketId, status])
  @@index([assigneeId, status, ticketId])
}

model ActionEvent {
  id            Int             @id @default(autoincrement())
  actionId      Int
  actorId       Int
  eventType     ActionEventType
  actionVersion Int
  fromStatus    ActionStatus?
  toStatus      ActionStatus?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  snapshot      Json?
  action        ActionTaken     @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor         User            @relation("ActionEventActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([actionId, actionVersion])
  @@index([actionId, createdAt, id])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())
  seedKey   String?  @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author    User     @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())
  seedKey   String?  @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author    User     @relation("PublicCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ticketId, createdAt, id])
}

model Attachment {
  id                  Int                   @id @default(autoincrement())
  ticketId            Int
  originalFilename    String
  storageKey          String                @unique
  mediaType           String
  byteSize            Int
  uploadedAt          DateTime              @default(now())
  removedAt           DateTime?
  removalReason       String?
  removedByUserId      Int?
  ticket              Ticket                @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  removedByUser        User?                 @relation("RemovedAttachmentUser", fields: [removedByUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([ticketId, removedAt])
}

model Session {
  id                String   @id @default(uuid())
  tokenHash         String   @unique
  userId            Int
  csrfSecret        String
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  absoluteExpiresAt DateTime
  restricted        Boolean  @default(false)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, absoluteExpiresAt])
  @@index([absoluteExpiresAt])
}

model LoginAttempt {
  id       Int      @id @default(autoincrement())
  key      String
  failedAt DateTime @default(now())

  @@index([key, failedAt])
}
