generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestedPriority {
  Low
  Medium
  High
  Urgent
}

enum CurrentStatus {
  New
  Open
  InProgress          @map("In Progress")
  WaitingForRequester @map("Waiting for Requester")
  Resolved
  Closed
  Reopened
  Cancelled
}

enum UserRole {
  Requester
  ITStaff
  Administrator
}

model Category {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  seedKey       String?  @unique
  tickets       Ticket[]

  @@index([isActive, displayOrder])
}

model RelatedSystem {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  seedKey       String?  @unique
  tickets       Ticket[]

  @@index([isActive, displayOrder])
}

model User {
  id                  Int          @id @default(autoincrement())
  displayName         String
  email               String       @unique
  role                UserRole     @default(Requester)
  passwordHash        String?
  mustChangePassword  Boolean      @default(true)
  isActive            Boolean      @default(true)
  seedKey             String?      @unique
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  tickets             Ticket[]
  ownedTickets        Ticket[]     @relation("TicketOwner")
  resolutionIndications Ticket[]   @relation("TicketResolutionIndication")
  removedAttachments  Attachment[] @relation("RemovedAttachmentUser")
  internalNotes       InternalNote[] @relation("InternalNoteAuthor")
  publicComments      PublicComment[] @relation("PublicCommentAuthor")
  sessions            Session[]

  @@index([isActive, displayName])
}

model Ticket {
  id                 Int              @id @default(autoincrement())
  ticketNumber       String           @unique
  ticketDate         DateTime         @default(now())
  requesterId        Int
  categoryId         Int
  relatedSystemId    Int
  summary            String
  description        String
  requestedPriority  RequestedPriority
  itPriority         RequestedPriority
  currentStatus      CurrentStatus    @default(New)
  ownerId            Int?
  version            Int              @default(1)
  resolutionIndicatedAt       DateTime?
  resolutionIndicatedByUserId Int?
  statusChangedAt    DateTime         @default(now())
  resolvedAt         DateTime?
  reopenedAt         DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  seedKey            String?          @unique
  requester          User             @relation(fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner              User?            @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  resolutionIndicatedBy User?        @relation("TicketResolutionIndication", fields: [resolutionIndicatedByUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  category           Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  relatedSystem      RelatedSystem    @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attachments        Attachment[]
  internalNotes      InternalNote[]
  publicComments     PublicComment[]

  @@index([requesterId, updatedAt])
  @@index([requesterId, currentStatus])
  @@index([requesterId, requestedPriority])
  @@index([requesterId, categoryId])
  @@index([requesterId, relatedSystemId])
  @@index([updatedAt, id])
  @@index([ownerId])
  @@index([currentStatus])
  @@index([itPriority])
  @@index([categoryId, relatedSystemId])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())
  seedKey   String?  @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author    User     @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())
  seedKey   String?  @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author    User     @relation("PublicCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ticketId, createdAt, id])
}

model Attachment {
  id                  Int                   @id @default(autoincrement())
  ticketId            Int
  originalFilename    String
  storageKey          String                @unique
  mediaType           String
  byteSize            Int
  uploadedAt          DateTime              @default(now())
  removedAt           DateTime?
  removalReason       String?
  removedByUserId      Int?
  ticket              Ticket                @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  removedByUser        User?                 @relation("RemovedAttachmentUser", fields: [removedByUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([ticketId, removedAt])
}

model Session {
  id                String   @id @default(uuid())
  tokenHash         String   @unique
  userId            Int
  csrfSecret        String
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  absoluteExpiresAt DateTime
  restricted        Boolean  @default(false)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, absoluteExpiresAt])
  @@index([absoluteExpiresAt])
}

model LoginAttempt {
  id       Int      @id @default(autoincrement())
  key      String
  failedAt DateTime @default(now())

  @@index([key, failedAt])
}
