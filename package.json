{
  "name": "toktickit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @toktickit/client --filter @toktickit/server dev",
    "db:generate": "pnpm --filter @toktickit/server db:generate",
    "db:migrate": "pnpm --filter @toktickit/server db:migrate",
    "db:start": "pnpm --filter @toktickit/server db:start",
    "db:status": "pnpm --filter @toktickit/server db:status",
    "db:stop": "pnpm --filter @toktickit/server db:stop",
    "db:studio": "pnpm --filter @toktickit/server db:studio",
    "db:seed": "pnpm --filter @toktickit/server db:seed",
    "db:validate": "pnpm --filter @toktickit/server db:validate",
    "openapi:check": "node scripts/openapi-check.mjs",
    "openapi:generate": "openapi-ts --file openapi-ts.config.mjs",
    "openapi:watch": "openapi-ts --file openapi-ts.config.mjs --watch",
    "build": "pnpm --filter @toktickit/client --filter @toktickit/server build",
    "test": "pnpm --filter @toktickit/client test && pnpm openapi:check && pnpm --filter @toktickit/server test",
    "check-types": "pnpm run typecheck",
    "typecheck": "pnpm --filter @toktickit/client --filter @toktickit/server typecheck",
    "preview": "pnpm --filter @toktickit/client preview",
    "check": "oxfmt --config oxfmt.config.ts --check . && oxlint --config oxlint.config.ts .",
    "fix": "oxfmt --config oxfmt.config.ts --write . && oxlint --config oxlint.config.ts --fix .",
    "commit": "commit",
    "commitlint": "commitlint --edit",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/prompt-cli": "^20.5.3",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^26.1.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "ultracite": "^7.10.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.13.0"
}
